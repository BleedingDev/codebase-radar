{
  "name": "@codebase-radar/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "modern build",
    "check": "node ../../scripts/check-source-rules.mjs && tsc --noEmit",
    "deploy": "modern deploy && node scripts/production-output-smoke.mjs --static",
    "dev": "modern dev",
    "smoke:production-output": "node scripts/production-output-smoke.mjs",
    "start": "modern start",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codebase-radar/contracts": "workspace:*",
    "@codebase-radar/core": "workspace:*",
    "@effect/atom-react": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/sql-pg": "4.0.0-beta.102",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.5.0-ultramodern.102",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.5.0-ultramodern.102",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.5.0-ultramodern.102",
    "@typeonce/effect-machine": "0.4.0",
    "effect": "4.0.0-beta.102",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "scheduler": "0.27.0",
    "strip-json-comments": "5.0.3"
  },
  "devDependencies": {
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.5.0-ultramodern.102",
    "@modern-js/tsconfig": "npm:@bleedingdev/modern-js-tsconfig@3.5.0-ultramodern.102",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "happy-dom": "20.11.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
