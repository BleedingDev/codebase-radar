{
  "name": "@codebase-radar/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "test": {
        "types": "./src/index.ts",
        "import": "./dist/test/index.js"
      },
      "default": null
    },
    "./runtime": {
      "test": {
        "types": "./src/runtime/index.ts",
        "import": "./dist/test/runtime/index.js"
      },
      "default": null
    }
  },
  "scripts": {
    "build:test-exports": "tsc -p tsconfig.exports.json",
    "check": "tsc --noEmit",
    "check:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "pnpm run build:test-exports && vitest run --config vitest.config.ts && vitest run --config golden/vitest.config.ts",
    "test:core": "pnpm run build:test-exports && vitest run --config vitest.core.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
